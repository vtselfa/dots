#!/bin/bash 
git status -uall --porcelain=v2 | gawk '\
{\
    if ($1 == "?") {\
        printf("??");\
        for (i=2; i<=NF; i++) {\
            printf(" %s", $i);\
        }\
        printf("\n");\
    }\
\
    else if ($1 == "u" || $1 == "1" && $2 ~ /^.[MTD]/) {\
        printf("%s", $2);\
        for (i=9; i<=NF; i++) {\
            printf(" %s", $i);\
        }\
        printf("\n");\
    }\
}'\
| fzf --bind 'ctrl-a:select-all,ctrl-d:deselect-all' --preview 'git diff --color=always --exit-code -- {2..} && cat {2..}' --print0 -m \
| gawk -v RS='\0' -v ORS='\0' '{for (i=2; i<NF; i++) printf $i " "; print $NF}' \
| xargs -0 -t -o git add $@
